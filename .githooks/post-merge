#!/bin/sh
# DIN-BriefNEO post-merge hook (Silent-on-Success)
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

if git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE "^(docs/|tools/docs_index\.js)"; then
  node -e "require('./tools/docs_index.js').buildIndex({force:true})" >/dev/null 2>&1 || true
fi
exit 0
