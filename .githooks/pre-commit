#!/bin/sh
# DIN-BriefNEO pre-commit hook (Silent-on-Success, Verbose-on-Failure)
LOG=$(mktemp)
trap 'rm -f "$LOG"' EXIT INT TERM

# 1. Biome Linter
if ! npm run check > "$LOG" 2>&1; then
  echo "❌ [pre-commit] Biome Linter & Format-Check fehlgeschlagen:" >&2
  cat "$LOG" >&2
  exit 1
fi

# 2. Test-Suite
if ! npm test > "$LOG" 2>&1; then
  echo "❌ [pre-commit] Unit-Tests fehlgeschlagen:" >&2
  cat "$LOG" >&2
  exit 1
fi

# 3. Fitness Gate & Index
if ! node tools/build_db.js -q > "$LOG" 2>&1; then
  echo "❌ [pre-commit] Fitness Gate fehlgeschlagen:" >&2
  cat "$LOG" >&2
  exit 1
fi

exit 0
