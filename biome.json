{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"website/js/**",
			"test/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"useIterableCallbackReturn": "error",
				"noAssignInExpressions": "error"
			},
			"complexity": {
				"useOptionalChain": "error",
				"useSimplifiedLogicExpression": "warn",
				"noUselessTernary": "warn"
			},
			"performance": {
				"useDomNodeTextContent": "error",
				"noDelete": "warn"
			},
			"style": {
				"useConst": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "error",
				"useNumberNamespace": "warn",
				"noNonNullAssertion": "warn",
				"useArrayLiterals": "warn"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"enabled": false
		},
		"globals": [
			"document",
			"window",
			"localStorage",
			"sessionStorage",
			"navigator",
			"console",
			"fetch",
			"performance",
			"URL",
			"URLSearchParams",
			"HTMLElement",
			"CustomEvent",
			"InputEvent",
			"KeyboardEvent",
			"MouseEvent",
			"PointerEvent",
			"Event",
			"MutationObserver",
			"DecompressionStream",
			"Blob",
			"Response",
			"Request"
		]
	},
	"json": {
		"formatter": {
			"enabled": false
		}
	}
}
