# Dependencies & environments
venv/
node_modules/
build/
Fonts/

# Agent / editor local state (Schutzfilter)
agent/cache/
.claude/
.opencode/
chat-exports/

# Lokales Scratch (Schutzfilter)
scratch/

# Python & Datenbanken (Schutzfilter)
__pycache__/
*.pyc
*.db
*.db-journal


# OS / Editor
.DS_Store
Thumbs.db
.directory

# Recherche-Rohdaten (14.3 MB ChromeStatus-Dumps nicht ins Git versionieren)
research/research_results/chrome_features_*.json
research/**/__pycache__/

# Research-Rohdaten (Labor, groß; bleiben lokal, nicht im Repo)
research/research_results/chrome_features_*_overview.txt
research/research_results/js_targeted_findings_*.json
research/research_results/features_*_targeted_findings.json
research/research_results/raw_user_batch_2.txt
research/address-autocomplete-api-openapi-specs.json

# Debug-Session-Traces (Artefakte, kein Code)
test/traces/
test/traces/*.json

# Secrets & API-Keys (Schutzfilter)
.secrets/
*.key
.env
.env.*

# merge.txt einer Review-Scheibe ist Build-Output: der Kopf traegt den Commit,
# und SHA256-Tabelle plus Blockzahl werden bei jedem Bau neu erzeugt. Wuerde
# man die Datei committen, hiesse sie nach dem Commit wieder anders als HEAD.
reviews/**/merge.txt
