#!/bin/sh
# DIN-BriefNEO post-checkout hook
# ===============================
# Haelt den Retrieval-Index (agent/cache/docs_search.db) nach einem Branch-/
# Commit-Wechsel frisch. $3 == 1 bedeutet Branch-Wechsel; reine Datei-Checkouts
# werden uebersprungen. Zusaetzlich wird geprueft, ob sich docs/ oder
# tools/docs_index.js veraendert haben.
[ "$3" = "1" ] || exit 0
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

OLD_REF="$1"
NEW_REF="$2"

if [ -n "$OLD_REF" ] && [ -n "$NEW_REF" ]; then
  if git diff-tree -r --name-only "$OLD_REF" "$NEW_REF" 2>/dev/null | grep -qE "^(docs/|tools/docs_index\.js)"; then
    echo "[post-checkout] Aktualisiere Dokumentations-Index..."
    node -e "require('./tools/docs_index.js').buildIndex({force:true})" >/dev/null 2>&1 || true
  fi
fi
exit 0
