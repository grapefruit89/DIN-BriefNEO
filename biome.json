{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"website/js/**",
			"test/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "error"
			},
			"style": {
				"useConst": "error"
			},
			"suspicious": {
				"noAssignInExpressions": "error",
				"useIterableCallbackReturn": "error",
				"noControlCharactersInRegex": "off"
			},
			"performance": {
				"useDomNodeTextContent": "error"
			},
			"complexity": {
				"useOptionalChain": "error"
			}
		}
	}
}
