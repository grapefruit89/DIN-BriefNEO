#!/bin/sh
# DIN-BriefNEO pre-commit hook
# ============================
# Erzwingt die vollständige lokale Gate-Kette:
# 1. Biome Linter & Format-Check (npm run check --silent)
# 2. Test-Suite (npm test --silent)
# 3. Fitness Gate (100 %) + Retrieval-Index (node tools/build_db.js -q)
#
# Aktivieren (einmalig pro Clone):
#   git config core.hooksPath .githooks
#
# Notfall-Bypass:
#   git commit --no-verify
set -e

echo "[pre-commit] 1/3 Biome Check ..."
npm run check --silent

echo "[pre-commit] 2/3 Test-Suite ..."
npm test --silent

echo "[pre-commit] 3/3 Fitness Gate + Index ..."
node tools/build_db.js -q

echo "[pre-commit] ✓ Alle Gates bestanden."
