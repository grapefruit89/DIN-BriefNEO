{
  "version": "1.1.0",
  "layer": "base",
  "description": "Übertragbare HARD-BAN-Sonden. Normative SSoT: docs/00-foundation/Immutable-Law-Catalog.md",
  "rules": [
    {
      "id": "B2",
      "catalog_ref": ["TM1", "A48"],
      "class": "hard-ban",
      "severity": "critical",
      "check": "regex",
      "category": "javascript",
      "description": "Legacy Date API and date libraries are forbidden. Use Temporal.",
      "pattern": "\\bnew\\s+Date\\(|\\bDate\\.now\\(|\\bDate\\.parse\\(|\\bmoment\\(|\\bdate-fns\\b|\\bluxon\\b|from ['\"]moment['\"]|from ['\"]date-fns['\"]|from ['\"]luxon['\"]",
      "file_patterns": ["*.js"],
      "exemptions": []
    },
    {
      "id": "W1",
      "catalog_ref": ["ADR-ANTIPATTERN §4"],
      "class": "hard-ban",
      "severity": "critical",
      "check": "regex",
      "category": "javascript",
      "description": "document.execCommand and queryCommandState are forbidden. Use Selection & Range.",
      "pattern": "\\bexecCommand\\(|\\bqueryCommandState\\(",
      "file_patterns": ["*.js"],
      "exemptions": []
    },
    {
      "id": "W7",
      "catalog_ref": ["A41"],
      "class": "hard-ban",
      "severity": "critical",
      "check": "regex",
      "category": "general",
      "description": "Google Fonts are forbidden (DSGVO, offline).",
      "pattern": "fonts\\.googleapis\\.com|fonts\\.gstatic\\.com",
      "file_patterns": ["*.html", "*.css", "*.js"],
      "exemptions": []
    },
    {
      "id": "B5",
      "catalog_ref": ["A38", "T2"],
      "class": "hard-ban",
      "severity": "critical",
      "check": "regex",
      "category": "general",
      "description": "External script/style/font CDNs are forbidden. This is an asset ban, not a ban on every HTTP URL.",
      "pattern": "cdn\\.jsdelivr\\.net|unpkg\\.com|cdnjs\\.cloudflare\\.com|ajax\\.googleapis\\.com",
      "file_patterns": ["*.html", "*.css", "*.js"],
      "exemptions": []
    }
  ]
}
